import AeneasCheck.Pure.Pretty
import AeneasCheck.Translate.Driver

/-!
Lean source-code backend: render `Pure.TranslatedCrate` as Lean
source that compiles against `backends/lean/Aeneas/Std`.

M9.0a polish: emit the same shape as `aeneas -backend lean` —
`import Aeneas`, the full `open` line, the standard linter / heartbeat
options, a top-level `namespace <crate>` block, and per-function
`/-- ... Source: ..., lines N:M-P:Q -/` docstrings. The body is
wrapped in `do …` to match the standard backend's monadic surface.

Byte-identity with the standard backend is the M9 convergence goal;
the body content (binops, calls) still uses the M7 placeholder until
M9.1+ adds the relevant cert events.
-/

namespace AeneasCheck.Backends

open AeneasCheck Pure Translate

/-- The "crate" segment of a qualified Rust name `crate::a::b` —
    everything up to the first `::`. Used to group decls into one
    `namespace …` block per crate. -/
def crateOf (qualified : String) : String :=
  (qualified.splitOn "::").headD qualified

/-- The header emitted at the top of every generated file. Matches the
    standard Aeneas backend's preamble so a downstream verifier can
    swap one output for the other. -/
def emitHeader (crateName : String) : String :=
  "-- THIS FILE WAS AUTOMATICALLY GENERATED BY AENEAS-LEAN-CHECKER\n" ++
  s!"-- [{crateName}]\n" ++
  "import Aeneas\n" ++
  "open Aeneas Aeneas.Std Result ControlFlow Error\n" ++
  "set_option linter.dupNamespace false\n" ++
  "set_option linter.hashCommand false\n" ++
  "set_option linter.unusedVariables false\n\n" ++
  "/- You can set the `maxHeartbeats` value with the `-max-heartbeats` CLI option -/\n" ++
  "set_option maxHeartbeats 1000000\n\n" ++
  "/- You can set the `maxRecDepth` value with the `-max-recdepth` CLI option -/\n" ++
  "set_option maxRecDepth 2048\n\n"

/-- Render one `def …` in monadic style, preceded by its docstring. -/
def emitDecl (d : Decl) : String := d.toLean ++ "\n"

/-- Group decls into namespace blocks keyed by their crate prefix.
    Order within each group is preserved (cert iteration order). -/
private def groupByCrate (decls : Array Decl) : Array (String × Array Decl) :=
  Id.run do
    let mut order : Array String := #[]
    let mut buckets : Std.HashMap String (Array Decl) := {}
    for d in decls do
      let c := crateOf d.qualifiedName
      if !buckets.contains c then
        order := order.push c
        buckets := buckets.insert c #[]
      buckets := buckets.insert c ((buckets.getD c #[]).push d)
    return order.map fun c => (c, buckets.getD c #[])

/-- Emit one `namespace …` block: `namespace c\n\n<decls>\nend c\n`. -/
def emitNamespace (c : String) (decls : Array Decl) : String :=
  let body := String.intercalate "\n" (decls.toList.map emitDecl)
  s!"namespace {c}\n\n" ++ body ++ s!"\nend {c}\n"

/-- Top-level entry: header + one namespace block per crate. -/
def emitTranslatedCrate (crateName : String) (tc : TranslatedCrate) : String :=
  let groups := groupByCrate tc.decls
  let header := emitHeader crateName
  let namespaces :=
    String.intercalate "\n" (groups.toList.map fun (c, ds) => emitNamespace c ds)
  header ++ namespaces

end AeneasCheck.Backends
